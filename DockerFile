# ---------------------------------------------------
# Этап 1: Финальный образ для запуска (Runtime)
# ---------------------------------------------------
FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS base
WORKDIR /app
EXPOSE 8080
EXPOSE 8081

# ---------------------------------------------------
# Этап 2: Сборка приложения (SDK)
# ---------------------------------------------------
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
ARG BUILD_CONFIGURATION=Release
WORKDIR /src

# Копируем csproj-файлы с учетом реальной структуры папок
COPY ["Bez_chistoq_Arhitecturi/School.API.csproj", "Bez_chistoq_Arhitecturi/"]
COPY ["School.Application/School.Application.csproj", "School.Application/"]
COPY ["School.Core/School.Core.csproj", "School.Core/"]
COPY ["School.Persistence/School.Persistence.csproj", "School.Persistence/"]

# Восстанавливаем пакеты
RUN dotnet restore "Bez_chistoq_Arhitecturi/School.API.csproj"

# Копируем весь остальной код
COPY . .

WORKDIR "/src/Bez_chistoq_Arhitecturi"
RUN dotnet build "School.API.csproj" -c $BUILD_CONFIGURATION -o /app/build

# ---------------------------------------------------
# Этап 3: Публикация
# ---------------------------------------------------
FROM build AS publish
ARG BUILD_CONFIGURATION=Release
RUN dotnet publish "School.API.csproj" -c $BUILD_CONFIGURATION -o /app/publish /p:UseAppHost=false

# ---------------------------------------------------
# Этап 4: Финальный чистый образ
# ---------------------------------------------------
FROM base AS final
WORKDIR /app
COPY --from=publish /app/publish .
ENTRYPOINT ["dotnet", "School.API.dll"]